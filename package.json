{
  "name": "towerdef",
  "private": true,
  "description": "Duskwardens: Workspace-Wurzel (sim = Simulationskern, meta = Profil/Ledger/Gacha ohne DOM, client = Browser-Client).",
  "workspaces": [
    "sim",
    "meta",
    "client"
  ],
  "scripts": {
    "aa-import": "cd sim && npx tsx ../tools/aa-import/index.ts",
    "aa-import:check": "cd sim && npx tsx ../tools/aa-import/index.ts --check",
    "crossover": "cd sim && npx tsx ../tools/aa-import/crossover.ts",
    "crossover:check": "cd sim && npx tsx ../tools/aa-import/crossover.ts --check",
    "crossover:vorlage": "cd sim && npx tsx ../tools/aa-import/crossover.ts --vorlage",
    "legends": "cd sim && npx tsx ../tools/aa-import/crossover.ts --legends",
    "legends:check": "cd sim && npx tsx ../tools/aa-import/crossover.ts --legends --check"
  }
}
