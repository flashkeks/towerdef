{
  "name": "towerdef-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Duskwardens Client M1: Vite + PixiJS v8, Sim laeuft im Browser, kein Server.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "assets": "node scripts/gen-sprites.mjs && node scripts/build-atlas.mjs",
    "shots:p4": "node scripts/shots-p4.mjs",
    "replay-check": "node scripts/replay-check.mjs",
    "perf": "node scripts/perf.mjs",
    "shots:p5": "node scripts/shots-p5.mjs",
    "audio-check": "node scripts/audio-check.mjs",
    "ability-check": "node scripts/ability-check.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
