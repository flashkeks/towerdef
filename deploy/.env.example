# Vorlage. Echte Werte nur in deploy/.env auf edge (steht in .gitignore), nie committen.
# Platzhalter in GROSSBUCHSTABEN, bewusst ohne Werte.
TD_MODE=production
TD_PORT=8080
TD_PUBLIC_ORIGIN=
TD_PUBLIC_HOST=
KEKGAME_ISSUER=kek-game
# JSON: {"KID":"OEFFENTLICHER_SCHLUESSEL_JWK_ODER_PEM"}  (oeffentlich, kein Geheimnis, trotzdem Konfiguration)
KEKGAME_PUBLIC_KEYS=
KEKGAME_URL=
TD_DB_PATH=/data/td.sqlite
TD_TRUST_PROXY=loopback
PAYMENT_PROVIDER=mock
PAYMENTS_LEGAL_REVIEW_DONE=
GACHA_DAILY_PULL_CAP=
LOG_LEVEL=info
