# ENTWURF (Paket P7). Nicht lauffaehig: setzt ein Repo-Root mit npm workspaces
# (sim, client, server) voraus, das es noch nicht gibt. Siehe docs/architecture.md, Abschnitt 8.
# Build-Kontext: Repo-Root.   docker build -f deploy/Dockerfile.draft -t td:draft .
# Keine Secrets im Image: alles ueber Umgebungsvariablen zur Laufzeit.

# --- Stufe 1: bauen (sim, client, server) ---
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY sim/package.json sim/
COPY client/package.json client/
COPY server/package.json server/
RUN npm ci
COPY sim sim
COPY client client
COPY server server
RUN npm run build --workspace sim \
 && npm run build --workspace client \
 && npm run build --workspace server
# Nur Produktions-Abhaengigkeiten behalten
RUN npm prune --omit=dev

# --- Stufe 2: Laufzeit ---
FROM node:22-bookworm-slim AS run
ENV NODE_ENV=production \
    TD_MODE=production \
    TD_PORT=8080 \
    TD_DB_PATH=/data/td.sqlite
WORKDIR /app
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/sim/dist sim/dist
COPY --from=build /app/sim/data sim/data
COPY --from=build /app/server/dist server/dist
COPY --from=build /app/server/data server/data
COPY --from=build /app/server/migrations server/migrations
COPY --from=build /app/client/dist client/dist
# Daten-Verzeichnis fuer SQLite (Volume), Nicht-Root-Nutzer "node" (uid 1000)
RUN mkdir -p /data && chown node:node /data
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.TD_PORT||8080)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/dist/main.js"]
