+/**
+ * Runde 16 E (10.10.2026): Taegliche Challenge und Bestwerte der Challenges. Reine Funktionen, kein DOM.
+ * Die Regeln selbst (Typ, Code, Pruefung) liegen in `sim/src/challenge.ts`; hier stehen der Tagesgenerator
+ * (UTC-Tag -> Regeln, offline, fuer alle gleich), die Embers-Belohnung (einmal pro Tag) und die lokalen Bestwerte.
+ * Tuerme, Helden und Karten kommen aus den Daten, nichts ist hart kodiert.
+ */
+import { z } from 'zod';
+import { DATA } from '../../sim/src/data';
+import { fnv1a64 } from '../../sim/src/hash';
+import { nextInt, seedRng } from '../../sim/src/prng';
+import { challengeTowers, encodeChallenge, normalizeRules, type ChallengeRules } from '../../sim/src/challenge';
+import type { Difficulty, Tiers, TowerType } from '../../sim/src/types';
+import { MAP_IDS } from './data';
+import type { Profile } from './profile';
+
+/** Embers fuer den ersten Sieg einer Tages-Challenge je UTC-Tag. */
+export const DAILY_EMBERS = 40;
+/** So viele Tage / Codes bleiben im Profil (juengste). */
+export const DAILY_KEEP = 30;
+export const CUSTOM_KEEP = 50;
+/** Wie `SEEN_MATCHES_MAX` im Profil (hier gespiegelt, damit `profile.ts` dieses Modul ohne Import-Kreis laden kann). */
+const SEEN_MAX = 100;
+
+// ---------------------------------------------------------------- Tag
+
+const DAY_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+export const isDay = (s: unknown): s is string => {
+  if (typeof s !== 'string') return false;
+  const m = DAY_RE.exec(s);
+  if (!m) return false;
+  const d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
+  return d.getUTCFullYear() === +m[1] && d.getUTCMonth() === +m[2] - 1 && d.getUTCDate() === +m[3];
+};
+/** UTC-Tag `YYYY-MM-DD` einer Zeit (ms seit 1970 oder Date). */
+export const utcDay = (t: number | Date = Date.now()): string => new Date(t).toISOString().slice(0, 10);
+
+// ---------------------------------------------------------------- Generator
+
+/** Ungefaehres Gesamtvermoegen (Geld + Ausgaben) eines guten Laufs vor Runde `r` (Bot-Messung 10.10.2026, Meadow, alle Schwierigkeiten gleich). */
+const WEALTH: readonly (readonly [number, number])[] = [[1, 650], [10, 3900], [20, 13400], [30, 39600], [40, 70000], [80, 250000]];
+export function wealthBefore(round: number): number {
+  const r = Math.max(1, round);
+  for (let i = 1; i < WEALTH.length; i++) {
+    if (r <= WEALTH[i][0]) {
+      const [x0, y0] = WEALTH[i - 1], [x1, y1] = WEALTH[i];
+      return Math.round(y0 + ((y1 - y0) * (r - x0)) / (x1 - x0));
+    }
+  }
+  return WEALTH[WEALTH.length - 1][1];
+}
+
+export interface DailyChallenge {
+  day: string;
+  /** Kurzname, z. B. "No Refunds". */
+  name: string;
+  rules: ChallengeRules;
+  code: string;
+}
+
+/**
+ * Regeln des Tages. Deterministisch aus dem Datum (und den Spieldaten), ohne Netz. Die Wuerfe laufen in fester Reihenfolge,
+ * jeder Wurf wird immer gezogen. Tages-Challenges ignorieren Wissensbaum und Powers, damit alle gleich spielen.
+ */
+export function dailyChallenge(day: string, maps: readonly string[] = MAP_IDS): DailyChallenge {
+  if (!isDay(day)) throw new Error(`Bad day "${String(day)}"`);
+  const rng = seedRng(parseInt(fnv1a64(`dw-daily:${day}`).slice(0, 8), 16));
+  const pick = <T>(a: readonly T[]): T => a[nextInt(rng, a.length)];
+  const chance = (pct: number): boolean => nextInt(rng, 100) < pct;
+
+  const map = pick(maps);
+  const difficulty: Difficulty = pick(['easy', 'medium', 'medium', 'hard'] as const);
+  const cap = DATA.difficulties[difficulty].endRound;
+  let span = pick([15, 20, 25]);
+  let start = pick([1, 1, 10, 20, 30, 40]);
+  const allTowers = challengeTowers();
+  const nTowers = pick([2, 3, 4, allTowers.length]);
+  const shuffled = [...allTowers];
+  for (let i = shuffled.length - 1; i > 0; i--) { const j = nextInt(rng, i + 1); [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]]; }
+  const towers = nTowers >= allTowers.length ? null : (shuffled.slice(0, nTowers) as TowerType[]);
+  const hero = chance(75) ? 'any' : 'none';
+  const tierCap = pick([5, 5, 5, 4, 3, 2]);
+  const lives = pick([null, null, null, null, 50, 25, 1]);
+  const noSell = chance(30);
+  const incomeRoll = pick([100, 100, 100, 100, 100, 50, 0]);
+  const [hpPct, speedPct] = pick([[100, 100], [100, 100], [100, 100], [100, 100], [100, 100], [120, 100], [100, 115], [130, 110], [80, 100]] as const);
+  const seed = nextInt(rng, 1 << 20) * 4096 + nextInt(rng, 4096);
+
+  let incomePct = incomeRoll;
+  let cash: number | null = null;
+  if (incomePct === 0) { span = 10; start = Math.max(1, cap - 10); }
+  if (start + span - 1 > cap) start = Math.max(1, cap - span + 1);
+  const end = start + span - 1;
+  if (incomePct === 0) cash = 20_000;
+  else if (start > 1) cash = Math.round((wealthBefore(start) * 0.85) / 50) * 50;
+  if (incomePct === 50 && cash !== null) cash = Math.round(cash / 2 / 50) * 50;
+  // Drei Tuerme oder weniger und Stufenlimit: mit viel Geld bleibt das fuer Stufe 2 sonst ein Geldhaufen ohne Ziel
+  if (cash !== null && tierCap <= 3 && towers && towers.length <= 2) cash = Math.round((cash * 0.6) / 50) * 50;
+
+  const rules = normalizeRules({
+    map, difficulty, seed, startRound: start, endRound: end, towers, hero, maxTier: [tierCap, tierCap, tierCap] as Tiers,
+    startCash: cash, lives, incomePct, noSell, noPowers: true, noKnowledge: true, hpPct, speedPct,
+  });
+  const name = lives === 1 ? 'Flawless' : incomePct === 0 ? 'Frozen Purse' : noSell ? 'No Refunds' : towers && towers.length <= 2 ? 'Small Garrison'
+    : hero === 'none' ? 'Lone Towers' : tierCap <= 3 ? 'Low Ceiling' : hpPct > 100 ? 'Tough Hides' : speedPct > 100 ? 'Swift Dusk' : start >= 20 ? 'Late Arrival' : 'Open Road';
+  void incomePct;
+  return { day, name, rules, code: encodeChallenge(rules) };
+}
+
+// ---------------------------------------------------------------- Bestwerte und Belohnung
+
+const nat = z.number().int().min(0);
+/** Bestwerte einer Challenge: Runden (hoechste), Sieg, und bei Siegen je Kennzahl das Minimum (Geld, Leben, Zeit in Ticks). */
+export const ChallengeBestSchema = z.object({
+  plays: nat,
+  won: z.boolean(),
+  rounds: nat,
+  spent: nat.nullable().default(null),
+  livesLost: nat.nullable().default(null),
+  ticks: nat.nullable().default(null),
+});
+export type ChallengeBest = z.infer<typeof ChallengeBestSchema>;
+
+export const ChallengesSchema = z.object({
+  /** UTC-Tag der letzten ausgezahlten Tagesbelohnung ('' = nie). */
+  dailyClaimed: z.string().default(''),
+  /** Bestwert je UTC-Tag (juengste `DAILY_KEEP`). */
+  daily: z.record(z.string(), ChallengeBestSchema).default({}),
+  /** Bestwert je Code (juengste `CUSTOM_KEEP`). */
+  custom: z.record(z.string(), ChallengeBestSchema).default({}),
+});
+export type ChallengesState = z.infer<typeof ChallengesSchema>;
+export const emptyChallenges = (): ChallengesState => ({ dailyClaimed: '', daily: {}, custom: {} });
+
+export const ChallengeResultSchema = z.object({
+  matchId: z.string().min(1),
+  /** `daily`: `key` ist der UTC-Tag; `custom`: `key` ist der Code. */
+  kind: z.enum(['daily', 'custom']),
+  key: z.string().min(1).max(4000),
+  won: z.boolean(),
+  roundsCleared: nat.max(9999),
+  /** Kennzahlen fuer spaetere Bestenlisten. */
+  spent: nat,
+  livesLost: nat.max(99999),
+  ticks: nat,
+});
+export type ChallengeResult = z.input<typeof ChallengeResultSchema>;
+
+export interface ChallengeReport {
+  duplicate: boolean;
+  best: ChallengeBest;
+  /** Neuer Bestwert (mehr Runden, erster Sieg oder eine bessere Kennzahl). */
+  improved: boolean;
+  embersGained: number;
+  /** Tagesbelohnung wurde mit diesem Lauf ausgezahlt. */
+  claimedNow: boolean;
+}
+
+const minOr = (a: number | null, b: number): number => (a === null ? b : Math.min(a, b));
+
+/** Bestwerte und Tagesbelohnung verbuchen. Das uebergebene Profil bleibt unveraendert; dieselbe `matchId` zaehlt nur einmal. */
+export function applyChallenge(p: Profile, resultIn: ChallengeResult, today: string = utcDay()): { profile: Profile; report: ChallengeReport } {
+  const r = ChallengeResultSchema.parse(resultIn);
+  const ch = p.challenges ?? emptyChallenges();
+  const table = r.kind === 'daily' ? ch.daily : ch.custom;
+  const old = table[r.key];
+  const blank: ChallengeBest = { plays: 0, won: false, rounds: 0, spent: null, livesLost: null, ticks: null };
+  if (p.seenMatches.includes(r.matchId)) return { profile: p, report: { duplicate: true, best: old ?? blank, improved: false, embersGained: 0, claimedNow: false } };
+  const b = old ?? blank;
+  const next: ChallengeBest = {
+    plays: b.plays + 1,
+    won: b.won || r.won,
+    rounds: Math.max(b.rounds, r.roundsCleared),
+    spent: r.won ? minOr(b.spent, r.spent) : b.spent,
+    livesLost: r.won ? minOr(b.livesLost, r.livesLost) : b.livesLost,
+    ticks: r.won ? minOr(b.ticks, r.ticks) : b.ticks,
+  };
+  const improved = !old || next.rounds > b.rounds || (next.won && !b.won) || next.spent !== b.spent || next.livesLost !== b.livesLost || next.ticks !== b.ticks;
+  // Tagesbelohnung: nur fuer den Sieg der Tages-Challenge von heute, einmal je Tag
+  const claimNow = r.kind === 'daily' && r.won && r.key === today && ch.dailyClaimed !== today;
+  const keepLatest = <T>(t: Record<string, T>, key: string, n: number): Record<string, T> => {
+    const keys = Object.keys(t).filter((k) => k !== key);
+    const drop = r.kind === 'daily' ? keys.sort().slice(0, Math.max(0, keys.length + 1 - n)) : keys.slice(0, Math.max(0, keys.length + 1 - n));
+    const out: Record<string, T> = {};
+    for (const k of keys) if (!drop.includes(k)) out[k] = t[k];
+    out[key] = t[key];
+    return out;
+  };
+  const merged = { ...table, [r.key]: next };
+  const nextTable = keepLatest(merged, r.key, r.kind === 'daily' ? DAILY_KEEP : CUSTOM_KEEP);
+  const challenges: ChallengesState = {
+    dailyClaimed: claimNow ? today : ch.dailyClaimed,
+    daily: r.kind === 'daily' ? nextTable : ch.daily,
+    custom: r.kind === 'custom' ? nextTable : ch.custom,
+  };
+  const embersGained = claimNow ? DAILY_EMBERS : 0;
+  const profile: Profile = {
+    ...p,
+    challenges,
+    embers: p.embers + embersGained,
+    seenMatches: [...p.seenMatches, r.matchId].slice(-SEEN_MAX),
+  };
+  return { profile, report: { duplicate: false, best: next, improved, embersGained, claimedNow: claimNow } };
+}
+
+/** Stand der Tages-Challenge fuer die Anzeige. */
+export function dailyStatus(p: Profile, day: string): { claimed: boolean; best: ChallengeBest | undefined } {
+  return { claimed: (p.challenges?.dailyClaimed ?? '') === day, best: p.challenges?.daily[day] };
+}
