+    const i = h('input', 'ch-input ed-num');
+    i.type = 'number';
+    i.placeholder = ph;
+    i.setAttribute('aria-label', label);
+    i.onkeydown = (e) => e.stopPropagation();
+    i.oninput = () => { set(i.value === '' ? null : Number(i.value)); update(); };
